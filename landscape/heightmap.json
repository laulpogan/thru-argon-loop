  "axis_conversion": {
    "summary": "Godot 4 uses Y-up right-handed metres (+X=East, +Y=Up, +Z=South/-Z=North). Unreal Engine 5.6 uses Z-up left-handed centimetres (+X=Forward, +Y=Right, +Z=Up, 1 m = 100 cm).",
    "frame_1_ue_anchor_cm": {
      "description": "Unrotated axis-aligned frame centered at the hero anchor ground point (3049.4802, 2346.6019, 6249.7935).",
      "position_cm": {
        "X_ue_cm": "(X_godot_m - 3049.4802) * 100.0",
        "Y_ue_cm": "(Z_godot_m - 6249.7935) * 100.0",
        "Z_ue_cm": "(Y_godot_m - 2346.6019) * 100.0"
      },
      "inverse_godot_m": {
        "X_godot_m": "3049.4802 + X_ue_cm / 100.0",
        "Y_godot_m": "2346.6019 + Z_ue_cm / 100.0",
        "Z_godot_m": "6249.7935 + Y_ue_cm / 100.0"
      },
      "yaw_deg": "atan2(-sin(yaw_godot), cos(yaw_godot)) in degrees (flips handedness)"
    },
    "frame_2_ue_bridge_frame_cameras_json": {
      "description": "Bridge-aligned frame used by reset/unreal/CAMERAS.json and gen.py / ue_main.py. Origin is at the bridge crossing (3049.482, 2347.261, 6249.796) so bridge deck (2348.281m) is at z_local = +1.02m (+102.0 cm). +X_local is along the creek axis CAX=(0.503, 0, 0.865); +Y_local is along the bridge axis BAX=(0.865, 0, -0.503); UE Y_cm = -Y_local * 100.0 (due to glTF Y-up import axis flip AX['sy']=-1).",
      "local_m_from_godot": {
        "dx": "X_godot_m - 3049.482",
        "dz": "Z_godot_m - 6249.796",
        "x_local_m": "(0.503 * dx + 0.865 * dz) / 1.001234",
        "y_local_m": "(0.865 * dx - 0.503 * dz) / 1.001234",
        "z_local_m": "Y_godot_m - 2347.261"
      },
      "ue_cm_from_local_m": {
        "X_ue_cm": "x_local_m * 100.0",
        "Y_ue_cm": "-y_local_m * 100.0",
        "Z_ue_cm": "z_local_m * 100.0"
      },
      "godot_from_local_m": {
        "X_godot_m": "3049.482 + 0.503 * x_local_m + 0.865 * y_local_m",
        "Y_godot_m": "2347.261 + z_local_m",
        "Z_godot_m": "6249.796 + 0.865 * x_local_m - 0.503 * y_local_m"
      }
    }
  },
